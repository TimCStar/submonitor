SUBMONITOR_ADMIN_PASSWORD=replace-with-a-long-admin-password
SUBMONITOR_MASTER_KEY=replace-with-at-least-32-random-characters

SUBMONITOR_HOST=0.0.0.0
SUBMONITOR_PORT=8787
SUBMONITOR_DATA_DIR=/app/data
