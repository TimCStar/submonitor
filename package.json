{
  "name": "submonitor",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "description": "Codex OAuth quota reset monitor and Sub2API automation console",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch src/server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/index.js",
    "test": "node --test",
    "check": "node --check src/server/index.js && node --check src/server/monitor-engine.js && vite build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "nodemailer": "^9.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  }
}
